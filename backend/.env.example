DATABASE_URL=postgresql+psycopg://jobpilot:change-me@localhost:5432/jobpilot
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON array; keep localhost and 127.0.0.1 if you use both locally.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Relative paths resolve from backend/, not the shell working directory.
UPLOAD_DIR=uploads/resumes
