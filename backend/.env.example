DATABASE_URL=postgresql+psycopg://jobpilot:change-me@localhost:5432/jobpilot
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON array; keep localhost and 127.0.0.1 if you use both locally.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Relative paths resolve from backend/, not the shell working directory.
UPLOAD_DIR=uploads/resumes

# Gmail is disabled until all three secret/config values are supplied locally.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# A separate Fernet key; do not reuse JWT_SECRET_KEY. See docs/GMAIL_SETUP.md.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://localhost:8000/email/gmail/callback
FRONTEND_URL=http://localhost:5173
